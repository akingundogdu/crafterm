{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@services/*": ["src/services/*"],
      "@ui/*": ["src/ui/*"],
      "@resources/*": ["src/resources/*"],
      "@tests/*": ["src/tests/*"],
      "@bridge/*": ["src/preload/*"]
    }
  },
  "include": ["src/ui/**/*", "src/preload/api.d.ts"]
}
