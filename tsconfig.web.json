{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@ui",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@models/*": ["src/models/*"],
      "@repositories": ["src/repositories/index.ts"],
      "@repositories/*": ["src/repositories/*"],
      "@texts": ["src/ui-texts/ui-texts.ts"],
      "@texts/*": ["src/ui-texts/*"],
      "@services": ["src/services/index.ts"],
      "@services/*": ["src/services/*"],
      "@ui/*": ["src/ui/*"],
      "@views/*": ["src/views/*"],
      "@resources/*": ["src/resources/*"],
      "@tests/*": ["src/tests/*"]
    }
  },
  "include": ["src/ui/**/*", "src/views/**/*", "src/services/**/*", "src/models/**/*", "src/repositories/**/*", "src/ui-texts/**/*"],
  "exclude": ["src/services/**/*.main.ts", "src/services/**/*.utils.ts", "src/services/**/*.service.ts"]
}
