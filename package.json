{
  "name": "crafterm",
  "productName": "Crafterm",
  "version": "0.1.0",
  "description": "cmux-like terminal manager — Electron + xterm.js + node-pty",
  "author": "Akin Gundogdu <info@akingundogdu.com>",
  "license": "MIT",
  "homepage": "https://github.com/akingundogdu/crafterm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akingundogdu/crafterm.git"
  },
  "bugs": {
    "url": "https://github.com/akingundogdu/crafterm/issues"
  },
  "keywords": [
    "terminal",
    "terminal-manager",
    "electron",
    "xterm",
    "node-pty",
    "tmux",
    "cmux",
    "macos"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w node-pty,better-sqlite3",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "deploy": "bash scripts/deploy.sh"
  },
  "build": {
    "appId": "com.akingundogdu.crafterm",
    "productName": "Crafterm",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sounds",
        "to": "sounds"
      },
      {
        "from": "resources/scripts",
        "to": "scripts"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.10.0",
    "codemirror": "^6.0.2",
    "mysql2": "^3.22.3",
    "node-pty": "^1.0.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
