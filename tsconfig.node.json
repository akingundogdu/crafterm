{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@services": ["src/services/index.ts"],
      "@services/*": ["src/services/*"],
      "@ui/*": ["src/ui/*"],
      "@resources/*": ["src/resources/*"],
      "@tests/*": ["src/tests/*"],
      "@bridge/*": ["src/core/bridge/*"]
    }
  },
  "include": ["src/core/**/*", "src/services/**/*.main.ts", "electron.vite.config.ts"]
}
