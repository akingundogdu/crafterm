{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@configs/*": ["src/configs/*"],
      "@services": ["src/services/index.ts"],
      "@services/*": ["src/services/*"],
      "@ui/*": ["src/ui/*"],
      "@resources/*": ["src/resources/*"],
      "@tests/*": ["src/tests/*"]
    }
  },
  "include": [
    "src/core/**/*",
    "src/configs/**/*",
    "src/services/**/*.main.ts",
    "src/services/**/*.types.ts",
    "src/services/channels.ts",
    "electron.vite.config.ts"
  ]
}
